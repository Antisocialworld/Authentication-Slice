# Environment variables for this project.
# Copy this file to .env and fill in the real values BY HAND. Never put real values here.

# SQLite connection string for Prisma. With the Prisma 7 config file, the
# relative path is resolved from the directory you run the CLI / dev server
# in (the project root), so this created the file at ./dev.db. Local file,
# not a secret.
DATABASE_URL="file:./dev.db"

# Gmail account used to send verification-code emails via Gmail SMTP.
# Set these to send real mail. If they are left blank/unset, the app falls
# back to logging the verification code to the server console instead.
# GMAIL_USER is the Gmail address (e.g. you@gmail.com) sending the mail.
GMAIL_USER=""
# GMAIL_APP_PASSWORD is the 16-character Gmail app password (NOT your real
# account password). Generate it in your Google Account > Security > App passwords.
GMAIL_APP_PASSWORD=""